#include <stdio.h>
#include <string.h>
#include <stdlib.h>

int main()
{
    int i, j, opt;
    char stri1[20], stri2[20];
    do {
        printf("\nEnter 1 for Concatination \nEnter 2 for Length \nEnter 3 for copy \nEnter 4 for compare \nEnter 5 for exit\n");
        scanf("%d", &opt);
        switch (opt)
        {
        case 1:
            printf("\nEnter String1:- ");
            scanf("%s", stri1);
            printf("\nEnter String2:- ");
            scanf("%s", stri2);
            strcat(stri2, stri1);
            printf("\nString concat is %s", stri2);
            break;
        case 2:
            printf("\nEnter String First:- ");
            scanf("%s", stri1);
            i = strlen(stri1);
            printf("\nString Length is %d", i);
            break;
        case 3:
            printf("\nEnter String 1:- ");
            scanf("%s", stri1);
            printf("\nEnter String2:- ");
            scanf("%s", stri2);
            printf("\nString 1 is %s", stri1);
            printf("\nString 2 is %s", stri2);
            strcpy(stri2, stri1);
            printf("After Copy");
            printf("\nString 1 is %s", stri1);
            printf("\nString 2 is %s", stri2);
            break;
        case 4:
            printf("\nEnter String1:-");
            scanf("%s", stri1);
            printf("\nEnter String2:-");
            scanf("%s", stri2);
            j = strcmp(stri2, stri1);
            if (j == 0)
                printf("\nString length is equal");
            else
                printf("\nString length is not equal");
            break;
        case 5:
            opt = 5;
            break;
        default:
            printf("\nInvalid Option Enter Again");
        }
    } while (opt != 5);
    return 0;
}
